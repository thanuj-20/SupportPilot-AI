# ── Environment variables (NEVER commit) ─────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# ── ML / FAISS binaries ───────────────────────────────────────────────────
# Committed so Render skips expensive rebuild on every deploy
# Only re-commit when models are retrained or index is rebuilt
*.joblib
!backend/ml/saved_models/metrics.json

# ── Logs ──────────────────────────────────────────────────────────────────
*.log

# ── Frontend build output ─────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/coverage/

# ── OS / IDE ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
