!backend/ml/saved_models/metrics.json

# ── Logs ──────────────────────────────────────────────────────────────────
*.log

# ── Frontend build output ─────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/coverage/

